{%- assign cross_sell_products = product.metafields.custom.cross_sell_products.value -%}

{% if cross_sell_products %}

  {{ 'cross-sell.css' | asset_url | stylesheet_tag }}

  <script src="{{ 'embla-carousel.min.js' | asset_url }}" defer></script>
  <script src="{{ 'cross-sell.js' | asset_url }}" defer></script>

  <div class="cross-sell__heading">
    {% if block.settings.heading != blank %}
      <h2 class="cross-sell__title">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="cross-sell__nav">
      <button 
        class="cross-sell__nav-btn cross-sell__nav-btn--prev js-prev" 
        aria-label="Previous slide"
        disabled
      >
        <span class="cross-sell__nav-btn-icon">
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </span>
      </button>
      <button 
        class="cross-sell__nav-btn cross-sell__nav-btn--next js-next"
        aria-label="Next slide"
      >
        <span class="cross-sell__nav-btn-icon">
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </span>
      </button>
    </div>
  </div>

  <div class="cross-sell__viewport js-viewport">
    <div class="cross-sell__container">
      {%- for cross_sell_product in cross_sell_products -%}
        <div class="cross-sell__slide">
          <article
            class="cross-sell__product js-cs-product"
            data-product-id="{{ cross_sell_product.id }}"
          >
            <a 
              href="{{ cross_sell_product.url }}"
              class="cross-sell__product-image-link"
            >
              {% if cross_sell_product.featured_image %}
                {{
                  cross_sell_product.featured_image
                  | image_url: width: 300
                  | image_tag:
                    loading: 'lazy',
                    class: 'cross-sell__product-image',
                    alt: cross_sell_product.featured_image.alt | default: cross_sell_product.title
                }}
              {% endif %}
            </a>

            <div class="cross-sell__product-details">
              <h3 class="cross-sell__product-title">
                <a href="{{ cross_sell_product.url }}">
                  {{ cross_sell_product.title | escape }}
                </a>
              </h3>

              <div class="cross-sell__product-price" aria-live="polite">
                {% if cross_sell_product.price_varies %}
                  <span
                    class="js-cs-price"
                  >
                    {{ cross_sell_product.price_min | money }}
                    – {{ cross_sell_product.price_max | money }}
                  </span>
                {% elsif cross_sell_product.compare_at_price > cross_sell_product.price %}
                  <span
                    class="js-cs-price"
                  >
                    <span class="visually-hidden">Sale price: </span>
                    {{ cross_sell_product.price | money }}
                  </span>

                  <s class="cross-sell__product-compare-price js-cs-compare-price">
                    <span class="visually-hidden">Regular price: </span>
                    {{ cross_sell_product.compare_at_price | money }}
                  </s>
                {% else %}
                  <span
                    class="js-cs-price"
                  >
                    {{ cross_sell_product.price | money }}
                  </span>

                  <s
                    class="cross-sell__product-compare-price js-cs-compare-price"
                    hidden
                  ></s>
                {% endif %}
              </div>
              {% assign product_form_id = 'CrossSell-ProductForm-' | append: cross_sell_product.id %}

              <div class="cross-sell__product-actions">
                <product-form-component
                  data-product-id="{{ cross_sell_product.id }}"
                  on:submit="/handleSubmit"
                  class="cross-sell__product-form"
                >
                  <div
                    class="visually-hidden"
                    aria-live="assertive"
                    role="status"
                    aria-atomic="true"
                    ref="liveRegion"
                  ></div>

                  {% form 'product',
                    cross_sell_product,
                    id: product_form_id,
                    novalidate: 'novalidate',
                    data-type: 'add-to-cart-form'
                  %}

                    {% unless cross_sell_product.has_only_default_variant %}
                      <select
                        class="cross-sell__product-variant-select js-cs-variant-selector"
                        name="id"
                        aria-label="Select {{ cross_sell_product.options_with_values[0].name }}"
                      >
                        <option value="">
                          {{ cross_sell_product.options_with_values[0].name }}
                        </option>

                        {% for variant in cross_sell_product.variants %}
                          <option
                            value="{{ variant.id }}"
                            data-variant-price="{{ variant.price }}"
                            data-compare-at-price="{{ variant.compare_at_price }}"
                            data-available="{{ variant.available }}"
                            {% unless variant.available %}disabled{% endunless %}
                          >
                            {{ variant.title }}{% unless variant.available %} - Sold out{% endunless %}
                          </option>
                        {% endfor %}
                      </select>
                    {% else %}
                      <input
                        type="hidden"
                        name="id"
                        value="{{ cross_sell_product.selected_or_first_available_variant.id }}"
                      >
                    {% endunless %}

                    <button
                      type="submit"
                      class="cross-sell__product-add js-cs-add"
                      {% unless cross_sell_product.has_only_default_variant %}
                        disabled
                      {% endunless %}
                    >
                      Add
                    </button>

                  {% endform %}
                </product-form-component>
              </div>
            </div>

          </article>
        </div>
      {%- endfor -%}
    </div>
  </div>

{% endif %}

{% schema %}
{
  "name": "Cross-sell",
  "tag": "section",
  "class": "cross-sell js-cross-sell",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pairs with"
    }
  ],
  "presets": [
    {
      "name": "Cross-sell"
    }
  ]
}
{% endschema %}